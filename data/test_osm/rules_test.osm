<!--
  HAND-WRITTEN TEST FILE (not real map data). Exercises the importer's tag
  rules; expected results are asserted in backend/tests/test_osm_rules.c:
    way 100 primary two-way 1-2-3     -> edges 1->3, 3->1 (node 2 = shape point)
    way 101 residential oneway=yes 3-4 -> edge 3->4 only
    way 102 footway 2-5               -> dropped (not routable)
    way 103 service access=private 4-6 -> dropped (no access)
    way 104 trunk toll=yes 4-7        -> edges 4->7, 7->4 with TOLL flag
    way 105 tertiary oneway=-1 7-8    -> edge 8->7 only
    way 106 building                  -> dropped (not a highway)
    way 107 residential access=destination 8-10 -> edges with RESTRICTED flag
    node 9 place=village              -> one place, state Karnataka
-->
