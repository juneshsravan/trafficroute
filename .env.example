# IndiaRoute AI server configuration. Copy to .env and edit; scripts/run.sh
# loads it. Secrets belong only in .env (git-ignored), never in code.

# --- data -------------------------------------------------------------------
# graph.bin produced by ira_import. Leave empty to serve the synthetic sample.
IRA_GRAPH_PATH=
# SQLite file with the place index (ira_import --db) and incident history.
IRA_DB_PATH=
IRA_SAMPLE_DIR=../data/sample
IRA_FRONTEND_DIR=../frontend

# --- network ----------------------------------------------------------------
IRA_BIND=127.0.0.1
IRA_PORT=8080
IRA_THREADS=4
# Only needed if the frontend is served from a different origin.
IRA_CORS_ORIGIN=
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
IRA_TRUST_PROXY=0

# --- routing ----------------------------------------------------------------
# Concurrent route searches. Each needs ~37 bytes x graph nodes of memory.
IRA_ROUTE_WORKERS=2
# Max nodes one search may settle (0 = unlimited). Bounds worst-case latency.
IRA_MAX_SETTLED=0
IRA_MAX_SNAP_M=5000

# --- security ---------------------------------------------------------------
# Bearer token for /api/v1/admin/*; at least 16 characters, otherwise the
# admin API is disabled. Generate one with:  openssl rand -hex 24
IRA_ADMIN_TOKEN=
IRA_RATE_ROUTE_PER_MIN=60
IRA_RATE_GENERAL_PER_MIN=300
IRA_RATE_INCIDENT_PER_HOUR=10

# --- traffic ----------------------------------------------------------------
# URL of a live feed in the normalised JSON format described in docs/api.md.
# Empty = no live traffic; routes use baseline estimates and say so.
IRA_TRAFFIC_FEED_URL=
IRA_TRAFFIC_API_KEY=
IRA_TRAFFIC_PROVIDER_NAME=
IRA_TRAFFIC_ATTRIBUTION=
IRA_TRAFFIC_POLL_SECONDS=300
# Documented delay MODEL for verified incidents (not measured traffic).
IRA_ACCIDENT_DELAY_FACTOR=2.0
IRA_ROADWORK_DELAY_FACTOR=1.5

# --- map tiles (passed to the browser) ----------------------------------------
# The public OSM tile server is for light development use only; use your own
# tile server or a commercial provider in production.
IRA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
IRA_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

IRA_LOG_LEVEL=1
